# Copy to a private VPS file with mode 0600. Never commit the filled file.
# Keep false until the VPS socket, database and R2 token are verified.
MEDIA_SCAN_ENABLED=false
DATABASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
# Use a separate bucket-scoped Cloudflare R2 token with Object Read & Write.
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
# Optional; install clamav-daemon on the VPS to provide this client.
CLAMDSCAN_BINARY=/usr/bin/clamdscan
