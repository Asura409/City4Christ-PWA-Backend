# Reference only: the worker reads process environment, not this file directly.
APP_ENV=staging
# Safe default. Set to resend only when live sending is intended.
EMAIL_DELIVERY_MODE=disabled
DATABASE_URL=
# Stable base64-encoded 32-byte secret, shared with the API verification config.
VERIFICATION_KEY_BASE64=
RESEND_API_KEY=
EMAIL_FROM="City4christ <info@city4christ.org>"
# Required for staging live delivery; exact email addresses, comma-separated.
EMAIL_RECIPIENT_ALLOWLIST=
# Appointment emails are opt-in after migration 41 and updated worker deployment.
PASTORAL_EMAIL_ENABLED=false
# Frontend app base URL (HTTPS); used only when appointment delivery is enabled.
PASTORAL_EMAIL_APP_URL=

# API defaults: signup remains closed pending product policy and rate limits.
PORT=10000
REGISTRATION_ENABLED=false

# Required HTTPS origin for browser sessions; no trailing slash.
APP_ORIGIN=
# Additional exact frontend origins, comma-separated.
CORS_ORIGINS=https://zeetechdot.github.io
# lax for same-origin; none for a separate frontend (always Secure).
REFRESH_COOKIE_SAME_SITE=lax
# Only actual trusted reverse proxy CIDRs; empty ignores forwarded IP headers.
TRUSTED_PROXY_CIDRS=
# Optional: configure both to enable Google. Never commit credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional private R2 upload signing. Configure all four together only after
# the VPS media worker is deployed and healthy. Keep the bucket private.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
